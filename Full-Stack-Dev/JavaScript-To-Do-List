<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dark Todo List</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
body{
    background: #0f172a;
    min-height: 100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family: 'Segoe UI', sans-serif;
}
.todo-container{
    width:100%;
    max-width:800px;
    background:#1e293b;
    padding:30px;
    border-radius:20px;
    box-shadow:0 0 30px rgba(0,0,0,0.5);
}
.title{
    text-align:center;
    color:white;
    font-weight:700;
    margin-bottom:25px;
}
.form-control{
    background:#334155;
    border:none;
    color:white;
}
.form-control:focus{
    background:#334155;
    color:white;
    box-shadow:none;
    border:1px solid #22c55e;
}
.task-card{
    background:#334155;
    color:white;
    border:none;
    border-radius:12px;
    padding:15px;
    margin-top:15px;
    transition:0.3s;
}
.task-card:hover{
    transform:translateY(-3px);
}
.task-text{
    font-size:18px;
    word-break:break-word;
}
.btn-update{
    background:#f59e0b;
    color:white;
    border:none;
}
.btn-update:hover{
    background:#d97706;
}
.btn-delete{
    background:#ef4444;
    color:white;
    border:none;
}
.btn-delete:hover{
    background:#dc2626;
}
</style>
</head>
<body>
<div class="todo-container">
    <h2 class="title"> Hamzah's To-Do List</h2>
    <div class="input-group mb-4">
        <input type="text" id="taskInput" class="form-control" placeholder="Enter your task...">
        <button class="btn btn-success" onclick="addTask()">Add Task</button>
    </div>
    <div id="taskList"></div>
</div>
<script>
function addTask(){
    let taskInput = document.getElementById("taskInput");
    let taskText = taskInput.value.trim();
    if(taskText === ""){
        alert("Please enter a task");
        return;
    }
    let taskList = document.getElementById("taskList");
    let taskDiv = document.createElement("div");
    taskDiv.className =
    "task-card d-flex justify-content-between align-items-center";
    taskDiv.innerHTML = `
        <span class="task-text">${taskText}</span>
        <div>
            <button class="btn btn-update btn-sm me-2" onclick="updateTask(this)">Update</button>
            <button class="btn btn-delete btn-sm" onclick="deleteTask(this)">Delete</button>
        </div>
    `;
    taskList.appendChild(taskDiv);
    taskInput.value = "";
}
function deleteTask(button){
    button.closest(".task-card").remove();
}
function updateTask(button){
    let taskCard = button.closest(".task-card");
    let textElement =
    taskCard.querySelector(".task-text");
    let currentText =
    textElement.innerText;
    let updatedText =
    prompt("Update Task:", currentText);
    if(updatedText !== null &&
       updatedText.trim() !== ""){
        textElement.innerText =
        updatedText;
    }
}
</script>
</body>
</html>
